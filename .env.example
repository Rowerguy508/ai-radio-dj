# RAY.DO Environment Variables
# Copy this file to .env.local and fill in your values

# ── Music Source (choose one or both) ──

# Apple Music
# Server-only. The browser asks /api/apple-music/token for a short-lived developer token.
# Never put the private key, or a developer token, in a NEXT_PUBLIC_ variable.
# Create a MusicKit key at https://developer.apple.com/account
# APPLE_MUSIC_PRIVATE_KEY is the .p8 PEM. In a single-line env value, write \n for newlines.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Comma-separated origins allowed to use the developer token. Exact match, no wildcard.
# Example: https://your-domain.example,http://localhost:3000
APPLE_MUSIC_ALLOWED_ORIGINS=

# Spotify
# Create an app at: https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:3000/api/spotify/callback (or https://YOUR_DOMAIN/api/spotify/callback)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── AI Commentary ──

# MiniMax for generating DJ commentary text
# Get API key at: https://platform.minimaxi.com
MINIMAX_API_KEY=

# ElevenLabs for text-to-speech voice
# Get API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Default ElevenLabs voice ID (optional, defaults to "Rachel")
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Optional: Supabase (cloud sync) ──

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──

NEXT_PUBLIC_APP_URL=http://localhost:3000
