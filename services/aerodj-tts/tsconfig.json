{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": [
    "api/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "config/*.json"
  ]
}
